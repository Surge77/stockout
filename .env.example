# Copy to .env (gitignored). Every value here is optional — the whole test suite and
# the seasonal-naive backtest run on synthetic data with this file absent.

# --- Kaggle -----------------------------------------------------------------
# `stockout fetch` prefers ~/.kaggle/kaggle.json. Set these only if you would
# rather keep the credential with the project than in your home directory.
# Get them at kaggle.com -> Settings -> API -> Create New Token.
#
# NOTE: Rossmann is a *competition* dataset. The API returns 403 until you have
# opened https://www.kaggle.com/competitions/rossmann-store-sales/rules while
# signed in and accepted the rules. A valid token is necessary but not sufficient.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Forecasting knobs ------------------------------------------------------
# Forecast horizon in days. This is also the minimum usable lag: at the forecast
# origin you do not know yesterday's sales for a date six weeks out, so features
# with a lag shorter than the horizon are rejected rather than silently accepted.
STOCKOUT_HORIZON_DAYS=42

# Rolling-origin backtest folds. Each fold walks the origin forward by one horizon.
STOCKOUT_N_FOLDS=5

# Days left empty between the end of train and the start of test. Non-zero only if
# you suspect the label takes time to settle; Rossmann's does not.
STOCKOUT_GAP_DAYS=0

# --- Inventory / decision layer ---------------------------------------------
# Replenishment lead time and review period, in days.
STOCKOUT_LEAD_TIME_DAYS=7
STOCKOUT_REVIEW_PERIOD_DAYS=7

# The newsvendor cost pair. The service level the policy targets is NOT a tuning
# knob — it is the critical ratio Cu / (Cu + Co) derived from these two numbers.
# Defaults say a lost sale hurts three times as much as carrying a unit, which
# implies a 75% target. Change the costs, and the target quantile moves with them.
STOCKOUT_UNDERAGE_COST=3.0
STOCKOUT_OVERAGE_COST=1.0
