# Copy to .env (gitignored). Every value here is optional — the whole test suite and
# the seasonal-naive backtest run on synthetic data with this file absent.

# --- Kaggle -----------------------------------------------------------------
# `stockout fetch` prefers ~/.kaggle/kaggle.json. Set these only if you would
# rather keep the credential with the project than in your home directory.
# Get them at kaggle.com -> Settings -> API -> Create New Token.
#
# NOTE: Rossmann is a *competition* dataset. The API returns 403 until you have
# opened https://www.kaggle.com/competitions/rossmann-store-sales/rules while
# signed in and accepted the rules. A valid token is necessary but not sufficient.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Forecasting knobs ------------------------------------------------------
# Forecast horizon in days. This is also the minimum usable lag: at the forecast
# origin, you do not know yesterday's sales for a date a week ahead, so features
# with a lag shorter than the horizon are rejected rather than silently accepted.
STOCKOUT_HORIZON_DAYS=7

# Rolling-origin backtest folds. Each fold walks the origin forward by one horizon.
STOCKOUT_N_FOLDS=5

# Days left empty between the end of train and the start of test. Non-zero only if
# you suspect the label takes time to settle; Rossmann's does not.
STOCKOUT_GAP_DAYS=0

# --- Models -----------------------------------------------------------------
# Training rows given to the kernel models. SVR and SVC are between quadratic and
# cubic in the row count, so they are capped and the cap is reported next to their
# score rather than applied silently. ADR 0015.
STOCKOUT_SUBSAMPLE_ROWS=5000

# Every estimator that draws random numbers is given this, so two runs of the same
# command produce the same table.
STOCKOUT_RANDOM_SEED=42

# --- Web app ----------------------------------------------------------------
# Only needed for `pip install -e ".[web]"` and `uvicorn stockout_web.main:app`.
#
# Signs the session cookie. Generated per process when unset, which is fine for
# development and wrong for anything else: every restart invalidates every session,
# and two workers would sign with different keys and reject each other's cookies.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOCKOUT_WEB_SECRET=

# The users table. Defaults to artifacts/users.db, which is gitignored.
STOCKOUT_WEB_DB=

# Set to 1 behind TLS so the session cookie is HTTPS-only. Off by default because
# the default address is http://127.0.0.1, and a Secure cookie is never sent over
# plain HTTP — turning it on there makes login silently fail.
STOCKOUT_WEB_HTTPS=

# The first admin, created only into an *empty* user table. Leave both blank and the
# first account registered through the form becomes the admin instead. There is
# deliberately no built-in default account: a shipped admin/admin is a back door.
STOCKOUT_ADMIN_EMAIL=
STOCKOUT_ADMIN_PASSWORD=
